{
  "name": "flying-eyeball",
  "version": "1.0.0",
  "description": "Flying Eyeball game",
  "scripts": {
    "dev": "npx wrangler pages dev . --ip 127.0.0.1",
    "db:migrate:local": "wrangler d1 migrations apply flying-eyeball-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply flying-eyeball-db --remote",
    "db:migrate-scores": "node scripts/migrate-scores-from-sheets.mjs --remote",
    "pages:deploy": "wrangler d1 migrations apply flying-eyeball-db --remote && wrangler pages deploy . --project-name mxn-flying-eyeball",
    "deploy": "npm run pages:deploy"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  },
  "author": "",
  "license": "ISC"
}
